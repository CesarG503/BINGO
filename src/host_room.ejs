  <!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Animate CSS -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/Mixgyt/RetroSci-Fi_library/dist/css/sci-fi.css">
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/gh/Mixgyt/RetroSci-Fi_library/dist/js/retrosci-fi.js" defer></script>
  <link rel="stylesheet" href="/css/gameCliente.css">
  <link rel="stylesheet" href="/css/panel_espera.css">
  <link rel="stylesheet" href="/css/perfil.css">
  <link rel="stylesheet" href="/css/game.css">
  <title>Bingo</title>
</head>
<body class="bg-dark text-light">

  <nav class="navbar bg-secondary px-4 py-2 d-flex justify-content-between align-items-center position-sticky top-0 z-3">
  
    <!-- Marca y Logo -->
    <div class="d-flex align-items-center gap-3">
      <span class="navbar-brand fs-4 fw-bold text-white">Bingo</span>
    </div>
  
    <!-- Navegación y Botón Discreto de Historial de Bolas -->
    <div class="d-flex align-items-center gap-3 flex-wrap">
      <button class="btn btn-sm btn-compact-bolas" id="btn-ver-bolas-host" title="Ver historial de bolas extraídas">
        <i class="fas fa-history text-warning me-1"></i>
        <span>Historial Bolas</span>
        <span class="badge bg-warning text-dark ms-1 rounded-pill" id="host-bolas-badge">0</span>
      </button>
      <button class="nav-item rounded-pill px-3 btn btn-outline-danger py-1 text-white text-decoration-none" id="btn-cerrar-sala">Cerrar Sala</button>
    </div>
  </nav>
  
<!-- Pantalla de lobby (Mismo formato y clase waiting-room que vista jugador) -->
  <div id="waiting-room" class="waiting-room">
    <div class="container mx-auto" style="max-width: 1080px;">

      <!-- RECUADROS PRINCIPALES (Mismo formato y estilo que Jugadores en la Sala) -->
      <div class="row g-4 mb-4 justify-content-center align-items-stretch">
        
        <!-- Tarjeta 1: CÓDIGO DE LA SALA & BOTÓN INICIAR -->
        <div class="col-lg-7">
          <div class="players-card shadow-lg h-100 d-flex flex-column">
            <div class="players-header py-3 px-4 d-flex justify-content-between align-items-center">
              <h4 class="text-white mb-0 fs-5">
                <i class="fas fa-gamepad me-2 text-warning"></i>Código de la Sala
              </h4>
              <span class="badge bg-primary-neon rounded-pill px-3 py-1 fs-6">
                <i class="fas fa-users me-1 text-info"></i><span id="n-jugadores">0</span> Conectados
              </span>
            </div>
            
            <div class="players-body p-4 text-center d-flex flex-column justify-content-center align-items-center flex-grow-1">
              <!-- ID de la sala en grande -->
              <div id="id-room-display" class="user-select-all text-warning fw-bold my-3" 
                   style="font-family: 'Courier New', Courier, monospace; font-size: clamp(3rem, 6vw, 4.5rem); letter-spacing: 6px; text-shadow: 0 0 25px rgba(251, 191, 36, 0.7); line-height: 1;">
                <%= id_room %>
              </div>
              <span id="id-room" hidden><%= id_room %></span>

              <!-- BOTÓN INICIAR PARTIDA -->
              <div id="btn-iniciar-sala" class="mt-3">
                <a class="btn btn-success btn-lg px-5 py-3 rounded-pill fw-bold d-inline-flex align-items-center gap-2 shadow-lg" 
                   style="font-size: 1.3rem; background: linear-gradient(135deg, #10b981, #059669); border: none; cursor: pointer; transition: transform 0.2s;"
                   onmouseover="this.style.transform='scale(1.04)'" onmouseout="this.style.transform='scale(1)'">
                  <img src="/img/iniciar.png" alt="Iniciar" style="width: 28px; height: 28px;">
                  <span>Iniciar Partida</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Tarjeta 2: CÓDIGO QR -->
        <div class="col-lg-5">
          <div class="players-card shadow-lg h-100 d-flex flex-column">
            <div class="players-header py-3 px-4 text-center">
              <h4 class="text-white mb-0 fs-5">
                <i class="fas fa-qrcode me-2 text-info"></i>Código QR
              </h4>
            </div>
            
            <div class="players-body p-4 text-center d-flex flex-column align-items-center justify-content-center flex-grow-1">
              <div class="p-3 bg-white rounded-4 shadow-lg d-inline-block my-auto">
                <img id="qr-code-img" src="<%= typeof qr_code !== 'undefined' ? qr_code : '' %>" 
                     alt="Código QR para unirse" 
                     style="width: 210px; height: 210px; display: block; object-fit: contain;">
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Lista de jugadores (Diseño Compacto Escalable) -->
      <div class="row justify-content-center mb-4">
          <div class="col-12">
              <div class="players-card shadow-lg">
                  <div class="players-header py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                      <div class="d-flex align-items-center gap-3">
                          <h4 class="text-white mb-0 fs-5">
                              <i class="fas fa-users me-2 text-info"></i>Jugadores Conectados en la Sala
                          </h4>
                          <span id="n-jugadores-badge" class="players-count-badge">
                              <i class="fas fa-circle text-success" style="font-size: 8px;"></i>
                              <span id="count-number">0</span>
                          </span>
                      </div>
                      <div class="player-search-wrapper ms-sm-auto position-relative">
                          <input type="text" id="player-search" class="players-search-box" placeholder="Buscar jugador..." autocomplete="off">
                      </div>
                  </div>
                  <div class="players-body p-3">
                      <div class="players-scroll-wrapper">
                          <div id="jugadores_content" class="players-compact-grid">
                              <!-- Los jugadores se cargan dinámicamente -->
                          </div>
                      </div>
                  </div>
              </div>
          </div>
      </div>

    </div>
  </div>
<!-- Pantalla de juego -->
<div id="game-controls" class="visually-hidden">
  <div id="host-banner-ganador" class="game-finished-banner d-none mx-3 my-1 text-center py-2 px-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div class="text-start">
        <h5 class="text-success mb-0 fw-bold"><i class="fas fa-trophy text-warning me-2"></i>¡Partida Finalizada!</h5>
        <span class="text-white-50 small" id="host-ganador-nombre">Ganador: -</span>
      </div>
      <div class="d-flex gap-2">
        <button class="btn btn-sm btn-info py-1" id="btn-ver-carton-ganador"><i class="fas fa-eye me-1"></i>Ver Cartón</button>
        <button class="btn btn-sm btn-outline-light py-1" id="btn-banner-ver-bolas"><i class="fas fa-list me-1"></i>Bolas Extraídas</button>
      </div>
    </div>
  </div>

  <div class="interfaz border border-2 border-neon-complete border-info">
    <div class="contenedor">
      <!-- RULETAZO CON LOS NUMEROS-->
      <div class="canva mx-auto">
        <div class="carrusel" id="carrusel">
          <div class="bola bola-o ">¡</div>
          <div class="bola bola-g ">¡</div>
          <div class="bola bola-b ">B</div>
          <div class="bola bola-i ">I</div>
          <div class="bola bola-n ">N</div>
          <div class="bola bola-g ">G</div>
          <div class="bola bola-o ">O</div>
          <div class="bola bola-i">!</div>
          <div class="bola bola-b">!</div>
        </div>
      </div>
      <!-- TUBO -->
      <div class="tubo">
        <div class="tubo-css"></div>
      </div>
      <!-- TABLA CON LOS NUMEROS -->
      <div class="numeros">
        <table class="tabla-numeros border border-3 ">
          <tbody id="tableBall"> <!--EL navegador me agregar el tbody :)-->
            <tr class="">
              <td class="bg-primary-subtle">
                <div class="bola bola-b">B</div>
              </td>
              <td></td>
              <td></td>
              <td></td>
