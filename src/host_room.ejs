              <td></td>
              <td></td>
              <td></td>
              <td></td>
              <td></td>
              <td></td>
              <td></td>
              <td></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  
   <div class="col-lateral-host">
      <div class="botones">
        <div class="formaParaGanar" >
          <table class="tabla-bingo-patron border border-2" id="tabla-bingo-patron">
            <thead>
              <tr>
                <th class="bg-primary-subtle"><div class="bola bola-b">B</div></th>
                <th class="bg-success-subtle"><div class="bola bola-i">I</div></th>
                <th class="bg-info-subtle"><div class="bola bola-n">N</div></th>
                <th class="bg-warning-subtle"><div class="bola bola-g">G</div></th>
                <th class="bg-danger-subtle"><div class="bola bola-o">O</div></th>
              </tr>
            </thead>
            <tbody>
              <tr>
