            </tbody>
          </table>
        </div>
        <button class="btn btn-subtle-patron" id="btn-confirmar-patron">
          <i class="fas fa-check-circle me-1"></i>Confirmar Forma
        </button>

        <div class="bola-actual-container">
          <div class="bola-selec bola-i" id="bola-selec">Bola</div>
        </div>

        <button class="btn btn-arcade-lanzar" id="btn-new-number">
          <i class="fas fa-dice me-2"></i>NUEVA BOLA
        </button>
  
      </div>
   </div>
  </div>
</div>

<script src="/js/game/formaParaganar.js" type="module"></script>

<script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
