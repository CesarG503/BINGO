# ==============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo a `.env` y configura los valores correspondientes:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Configuración del Servidor y Aplicación (Node.js / Express)
# ------------------------------------------------------------------------------
# Entorno de ejecución (development | production)
NODE_ENV=production

# Puerto interno en el que corre el servidor dentro del contenedor
PORT=3000

# Puerto del host expuesto para acceder a la aplicación en el navegador (http://localhost:3001)
HOST_PORT=3001

# URL base accesible públicamente (usada para enlaces en correos y redirecciones)
API_BASE_URL=http://localhost:3001

# URL base personalizada para los códigos QR del administrador (Opcional)
# Si se deja vacía o no se define, se detectará automáticamente el protocolo y host
# desde el cual el administrador accede a la sala (ideal para despliegues en Render,
# Railway, VPS, túneles ngrok o red local WiFi).
# Ejemplo para producción: QR_BASE_URL=https://tu-dominio-o-render.com
QR_BASE_URL=

# ------------------------------------------------------------------------------
# Servicio de Correos (Gmail / Nodemailer)
# ------------------------------------------------------------------------------
# Contraseña de aplicación de Google de 16 caracteres (Google App Password)
# Necesaria para enviar correos de restablecimiento de contraseña desde bingoappues@gmail.com
GOOGLE_API_KEY=tu_google_app_password

# ------------------------------------------------------------------------------
# Configuración de la Base de Datos (PostgreSQL)
# ------------------------------------------------------------------------------
# Credenciales y datos del contenedor PostgreSQL (servicio 'db' en docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=adminBingo14
POSTGRES_DB=bingodb
DB_HOST=db
DB_PORT=5433

# URL de conexión PostgreSQL para la aplicación Node.js (usada por pg Pool)
# Si usas el contenedor local 'db':
DATA_BASE_URL=postgresql://postgres:adminBingo14@db:5432/bingodb

# Si usas una base de datos externa, descomenta y ajusta:
# DATA_BASE_URL=postgresql://usuario:password@host_externo:5432/bingodb

